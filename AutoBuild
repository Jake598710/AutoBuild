    -- ══════════════════════════════════════════════════════════════════════
    -- RESPONSIVE TEXT / UI SCALE (small viewports = mobile)
    --
    -- Mobile used to only get a smaller WINDOW (see INIT_W/INIT_H below), so the
    -- fixed 12-16px text and the paddings stayed desktop-sized: the UI looked
    -- blown up and long labels clipped. Two obvious shortcuts are deliberately
    -- NOT used here:
    --   * UIScale      -> resamples already-rendered text, which reads as blur
    --                     (this was reported on this hub before).
    --   * TextScaled   -> the engine docs warn text can shrink below readable and
    --                     recommend sizing the UI instead; it also needs a
    --                     UITextSizeConstraint to be safe.
    -- Instead TextSize / padding / corner metrics are rewritten from bases that
    -- are recorded the first time an instance is seen, so text stays crisp and
    -- applying a different factor later is exact rather than compounding.
    -- Minimum text size is 9, per the engine docs.
    -- ══════════════════════════════════════════════════════════════════════
    PongiUI.TextScale = PongiUI.TextScale or 1
    PongiUI.SizeScale = PongiUI.SizeScale or 1
    local rsBase = setmetatable({}, { __mode = 'k' })

    local function rsEntry(g)
        local e = rsBase[g]
        if not e then e = {}; rsBase[g] = e end
        return e
    end
    local function rsNum(g, p)
        local ok, v = pcall(function() return g[p] end)
        if ok and type(v) == 'number' then return v end
        return nil
    end
    local function rsScaleNumber(g, p, factor, min)
        local cur = rsNum(g, p)
        if cur == nil then return end
        local e = rsEntry(g)
        if e[p] == nil then e[p] = cur end
        local want = math.floor(e[p] * factor + 0.5)
        if min and want < min then want = min end
        if cur ~= want then pcall(function() g[p] = want end) end
    end
    local function rsScaleUDim(g, p, factor)
        local ok, v = pcall(function() return g[p] end)
        if not ok or typeof(v) ~= 'UDim' then return end
        local e = rsEntry(g)
        if e[p] == nil then e[p] = { v.Scale, v.Offset } end
        local b = e[p]
        local o = math.floor(b[2] * factor + 0.5)
        if v.Offset ~= o then pcall(function() g[p] = UDim.new(b[1], o) end) end
    end
    local function rsApplyOne(g, tf, sf)
        if not g or not g.Parent then return end
        if rsNum(g, 'TextSize') ~= nil then
            rsScaleNumber(g, 'TextSize', tf, 9)
        end
        if g:IsA('UIListLayout') then
            rsScaleUDim(g, 'Padding', sf)
        elseif g:IsA('UIPadding') then
            rsScaleUDim(g, 'PaddingTop', sf)
            rsScaleUDim(g, 'PaddingBottom', sf)
            rsScaleUDim(g, 'PaddingLeft', sf)
            rsScaleUDim(g, 'PaddingRight', sf)
        elseif g:IsA('UICorner') then
            rsScaleUDim(g, 'CornerRadius', sf)
        end
        -- engine trap: a TextWrapped label whose wrapped text is TALLER than its
        -- fixed height renders that line not at all (text silently vanishes on
        -- small viewports). Let those grow instead of fighting the shrink.
        if rsNum(g, 'TextSize') ~= nil then
            local okW, wrapped = pcall(function() return g.TextWrapped end)
            local okF, fits = pcall(function() return g.TextFits end)
            if okW and wrapped and okF and fits == false then
                local okA, as = pcall(function() return g.AutomaticSize end)
                if okA and as == Enum.AutomaticSize.None then
                    pcall(function() g.AutomaticSize = Enum.AutomaticSize.Y end)
                end
            end
        end
    end
    function PongiUI:ApplyResponsiveScale(rootOverride)
        local root = rootOverride or (Window and Window._root)
        if not root then return end
        local tf, sf = PongiUI.TextScale or 1, PongiUI.SizeScale or 1
        local okList, list = pcall(function() return root:GetDescendants() end)
        if okList then
            for _, g in ipairs(list) do rsApplyOne(g, tf, sf) end
        end
        rsApplyOne(root, tf, sf)
    end
    function PongiUI:SetResponsiveScale(tf, sf)
        PongiUI.TextScale = math.clamp(tf or 1, 0.6, 1.2)
        PongiUI.SizeScale = math.clamp(sf or 1, 0.6, 1.2)
        PongiUI:ApplyResponsiveScale()
    end
    -- reference viewport is 1080p: Roblox hands a phone a much smaller logical
    -- viewport (landscape ~720), so identical TextSize looks far larger there.
    local function rsComputeFactors()
        local vpY = 1080
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then vpY = cam.ViewportSize.Y end
        end)
        local touch = false
        pcall(function() touch = UserInputService.TouchEnabled end)
        local keyboard = true
        pcall(function() keyboard = UserInputService.KeyboardEnabled end)
        local mobile = touch and not keyboard
        -- test the phone path from a PC without a phone
        pcall(function()
            if _G.PONGI_UI_FORCE_MOBILE then mobile = true end
        end)
        local tf = math.clamp(vpY / 1080, 0.80, 1.05)
        if mobile then tf = math.max(0.74, tf - 0.06) end
        local sf = math.clamp(vpY / 1080, 0.85, 1)
        if mobile then sf = math.max(0.80, sf - 0.05) end
        -- explicit override for testing / a UI slider: _G.PONGI_UI_TEXT_SCALE
        local o1 = tonumber(_G.PONGI_UI_TEXT_SCALE)
        if o1 then tf = math.clamp(o1, 0.6, 1.2) end
        local o2 = tonumber(_G.PONGI_UI_SIZE_SCALE)
        if o2 then sf = math.clamp(o2, 0.6, 1.2) end
        return tf, sf
    end
