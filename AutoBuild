    local function _new(cls, parent)
        local old = getthreadidentity and getthreadidentity() or 8
        if setthreadidentity then setthreadidentity(2) end
        local ok, inst
        if parent then
            ok, inst = pcall(function() return Instance.new(cls, parent) end)
        else
            ok, inst = pcall(function() return Instance.new(cls) end)
        end
        if setthreadidentity then setthreadidentity(old) end
        if not ok then
            warn('[PongiUI] Instance.new failed for ' .. tostring(cls))
            return nil
        end
        return inst
    end

     
    local function randName(len)
        local chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'
        local out = {}
        for _ = 1, (len or 12) do
            local i = math.random(1, #chars)
            out[#out + 1] = chars:sub(i, i)
        end
        return table.concat(out)
    end

     
     
     
     
     
