        function TabMeta:Show()
            if tab._visible then return end
            tab._visible = true
            for _, t in ipairs(self._owner._tabs) do
                if t ~= tab then t:Hide() end
            end
            tab._left.Parent = self._owner._left
            tab._right.Parent = self._owner._right
            tab._left.Visible = true
            tab._right.Visible = true
            tab._btn.BackgroundColor3 = theme.accent
            tab._btn.TextColor3 = Color3.new(1, 1, 1)
            btnStroke.Color = theme.accent2
             
            local host = self._owner._bannerHost
            for _, t in ipairs(self._owner._tabs) do
                if t._banner and t._banner.Parent == host then t._banner.Visible = false end
            end
            if tab._banner then
                tab._banner.Parent = host
                tab._banner.Visible = true
            end
            task.defer(applyBannerHeight)
        end

        function TabMeta:Hide()
            tab._visible = false
            tab._left.Visible = false
            tab._right.Visible = false
            tab._btn.BackgroundColor3 = theme.main2
            tab._btn.TextColor3 = theme.font
            btnStroke.Color = theme.outline
            if tab._banner then tab._banner.Visible = false end
            applyBannerHeight()
        end

        tab._banner = nil

        function TabMeta:AddLeftGroupbox(name, icon, opts)
            local gb = GroupboxFactory(tab._left, name, icon)
            if opts and opts.innerScrollHeight then
                gb:UseInnerScroll(opts.innerScrollHeight)
            end
            return gb
        end
        function TabMeta:AddRightGroupbox(name, icon, opts)
            local gb = GroupboxFactory(tab._right, name, icon)
            if opts and opts.innerScrollHeight then
                gb:UseInnerScroll(opts.innerScrollHeight)
            end
            return gb
        end

        tab = setmetatable(tab, TabMeta)
        table.insert(self._tabs, tab)
        btn.Activated:Connect(function()
            tab:Show()
        end)
        if #self._tabs == 1 then
            tab:Show()
        end
        return tab
    end

