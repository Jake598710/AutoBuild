                    end
                end
            end)
            task.delay(0.32, function()
                pcall(function() s:Destroy() end)
            end)
        end
        return handle
    end

     
     
     
     
    function PongiUI:SetGroupboxIconSize(n)
        n = tonumber(n)
        if not n or n < 14 or n > 48 then return false end
        GROUPBOX_ICON_SIZE = math.floor(n)
        if _G then _G.PONGI_GROUPBOX_ICON_SIZE = GROUPBOX_ICON_SIZE end
        for _, e in ipairs(registeredGroupboxIcons) do
            pcall(function()
                if e.holder then
                    e.holder.Size = UDim2.fromOffset(GROUPBOX_ICON_SIZE, GROUPBOX_ICON_SIZE)
                    e.holder.Position = UDim2.fromOffset(10, math.max(0, (34 - GROUPBOX_ICON_SIZE) / 2))
                     
                end
            end)
        end
        return true
    end

    function PongiUI:Notify(info)
        info = info or {}
         
         
         
        local holder = _new('Frame')
        holder.Size = UDim2.fromOffset(300, 0)
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.ZIndex = 210
        holder.Parent = NotifyArea

        local card = _new('Frame')
        card.Size = UDim2.new(1, 0, 0, 0)
        card.BackgroundColor3 = theme.main
        card.BorderSizePixel = 0
        corner(card, 10)
        stroke(card, theme.outline, 1)
        card.ClipsDescendants = true
        card.Parent = holder

         
         
        local title = newFont(14, true)
        title.Size = UDim2.new(1, -32, 0, 18)
        title.Position = UDim2.fromOffset(16, 12)
        title.Text = info.Title or ''
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = card
        local desc = newFont(13)
        desc.Size = UDim2.new(1, -32, 0, 0)
        desc.Position = UDim2.fromOffset(16, 34)
        desc.Text = info.Description or ''
        desc.TextWrapped = true
        desc.LineHeight = 1.15
        desc.TextColor3 = theme.font
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextYAlignment = Enum.TextYAlignment.Top
        desc.Parent = card

         
         
         
         
        local innerW = 268
         
         
         
         
         
        local lineH = desc.LineHeight or 1
        local bounds = TPS:GetTextSize(desc.Text, desc.TextSize, desc.Font, Vector2.new(innerW, 1000))
        local h = math.max(76, 56 + math.ceil(bounds.Y * lineH) + 1)
        holder.Size = UDim2.fromOffset(300, h)
        card.Size = UDim2.new(1, 0, 0, h)
         
         
        desc.Size = UDim2.new(1, -32, 0, math.max(20, h - 56))
         
         
        task.defer(function()
            pcall(function()
                local need = 56 + math.ceil(TPS:GetTextSize(desc.Text, desc.TextSize, desc.Font, Vector2.new(innerW, 1000)).Y * lineH) + 1
                if need > h then
                    h = need
                    holder.Size = UDim2.fromOffset(300, h)
                    card.Size = UDim2.new(1, 0, 0, h)
                    desc.Size = UDim2.new(1, -32, 0, math.max(20, h - 56))
                end
            end)
        end)
        local t = info.Time or 3
         
         
        local timerFill = _new('Frame')
        timerFill.Size = UDim2.new(1, -16, 0, 2)
        timerFill.Position = UDim2.new(0, 8, 1, -8)
        timerFill.BackgroundColor3 = theme.accent
        timerFill.BorderSizePixel = 0
        corner(timerFill, 1)
        timerFill.Parent = card

         
        card.BackgroundTransparency = 1
        card.Position = UDim2.fromOffset(320, 0)
        tween(card, { BackgroundTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.17)
         
        tween(timerFill, { Size = UDim2.new(0, 0, 0, 2) }, t, Enum.EasingStyle.Linear)
        task.delay(t + 0.1, function()
             
            pcall(function()
                tween(card, { BackgroundTransparency = 1 }, 0.14)
                tween(title, { TextTransparency = 1 }, 0.14)
                tween(desc, { TextTransparency = 1 }, 0.14)
                tween(timerFill, { BackgroundTransparency = 1 }, 0.14)
                local hs = card:FindFirstChildOfClass('UIStroke')
                if hs then tween(hs, { Transparency = 1 }, 0.14) end
            end)
            tween(card, { Position = UDim2.fromOffset(320, 0) }, 0.14)
            task.delay(0.18, function()
                holder:Destroy()
            end)
        end)
        return holder
    end

     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
    do
        local function fmtMoney(n)
            local s = tostring(math.floor(tonumber(n) or 0))
            local out = s:reverse():gsub('(%d%d%d)', '%1,'):reverse()
            return out:gsub('^,', '')
        end
        local function fmtDur(sec)
            sec = math.max(0, math.floor(tonumber(sec) or 0))
            return string.format('%02d:%02d:%02d',
                math.floor(sec / 3600), math.floor((sec % 3600) / 60), sec % 60)
        end
        local function findHub()
            for _, g in ipairs(CoreGui:GetDescendants()) do
                if g:IsA('ScreenGui') and g:GetAttribute('PongihubUI') then return g end
            end
            return nil
        end
        local function resolve(hub)
            local head, gb = nil, nil
            for _, d in ipairs(hub:GetDescendants()) do
                if d:IsA('TextLabel') and d.Text == 'Status' and d.TextSize >= 14 then
                    head = d.Parent
                    gb = head and head.Parent
                    break
                end
            end
            if not gb then return nil end
            local container = nil
            for _, c in ipairs(gb:GetChildren()) do
                if c:IsA('Frame') and c ~= head then container = c end
            end
            if not container then return nil end
            local earnedL, totalL, sessionL, actionL, spinF = nil, nil, nil, nil, nil
            for _, d in ipairs(container:GetDescendants()) do
                if d:IsA('TextLabel') then
                    local t = d.Text or ''
                    if t:match('^Earned:') then earnedL = d
                    elseif t:match('^Total:') then totalL = d
                    elseif t:match('^Session:') then sessionL = d
                    elseif d.TextTruncate == Enum.TextTruncate.AtEnd and d.TextSize <= 13 then actionL = d end
                elseif d:IsA('Frame') then
                    local n = 0
                    for _, k in ipairs(d:GetChildren()) do
                        if k:IsA('Frame') and k.Size and k.Size.X and k.Size.X.Offset and k.Size.X.Offset <= 4 then
                            n = n + 1
                        end
                    end
                    if n >= 8 then spinF = d end
                end
            end
            if not (earnedL and totalL and sessionL and actionL and spinF) then return nil end
            local spinEntry = nil
            for _, s in ipairs(PongiUI._spinners) do
                if s.Frame == spinF then spinEntry = s; break end
            end
            return {
                earnedL = earnedL, totalL = totalL, sessionL = sessionL,
                actionL = actionL, spinF = spinF, spinEntry = spinEntry,
            }
        end
         
         
         
         
         
        if _G.__PONGI_STATUS_DRIVER__ ~= 'v2' then
            _G.__PONGI_STATUS_DRIVER__ = 'v2'
            task.spawn(function()
                local shared = {
                    got = false, earned = 0, total = 0, session = 0,
                    status = 'Idle', active = false,
                }
                 
                 
                 
                 
                 
                 
                 
                 
                 
                 
                 
                 
                 
                local hubRef = nil
                local function checkHub()
                    if hubRef and hubRef.Parent then return hubRef end
                    hubRef = nil
                    for _, g in ipairs(CoreGui:GetDescendants()) do
                        if g:IsA('ScreenGui') and g:GetAttribute('PongihubUI') then
                            hubRef = g
                            break
                        end
                    end
                    return hubRef
                end
                task.spawn(function()
                    while true do
                        task.wait(0.5)
                        local hubUp = checkHub() ~= nil
                        if not hubUp then
                            shared.got = false
                        else
                            local env = getgenv and getgenv() or _G
                            local af = env.PONGIHUB_AUTOFARM or _G.PONGIHUB_AUTOFARM
                            if af and af.getStatus then
                                local ok, st = pcall(function() return af.getStatus() end)
                                if ok and st then
                                    shared.got = true
                                    shared.earned = st.earned or 0
                                    shared.total = st.total or 0
                                    shared.session = st.session or 0
                                    shared.status = st.status or 'Idle'
                                    shared.active = st.active or false
                                end
                            end
                        end
                    end
                end)
                 
                local cur = nil
                local mainHub = nil
                while true do
                    task.wait(0.5)
                    pcall(function()
                         
                         
                        if mainHub and mainHub.Parent then
                             
                        else
                            mainHub = nil
                            for _, g in ipairs(CoreGui:GetDescendants()) do
                                if g:IsA('ScreenGui') and g:GetAttribute('PongihubUI') then
                                    mainHub = g
                                    break
                                end
                            end
                        end
                        local hub = mainHub
                        if not hub then cur = nil; return end
                        if not cur or cur.earnedL.Parent == nil then cur = resolve(hub) end
                        if not cur or not shared.got then return end
                        local e, t, s = fmtMoney(shared.earned), fmtMoney(shared.total), fmtDur(shared.session)
                        if cur.earnedL.Text ~= 'Earned: $' .. e then cur.earnedL.Text = 'Earned: $' .. e end
                        if cur.totalL.Text ~= 'Total: $' .. t then cur.totalL.Text = 'Total: $' .. t end
                        if cur.sessionL.Text ~= 'Session: ' .. s then cur.sessionL.Text = 'Session: ' .. s end
                        if cur.actionL.Text ~= shared.status then cur.actionL.Text = shared.status end
                        if cur.spinEntry then
                            cur.spinEntry:SetBusy(shared.active)
                        elseif cur.spinF then
                             
                             
                             
                             
                            cur.spinF.Visible = shared.active
                            if shared.active then
                                if not cur._conn then
                                    local ang = 0
                                    cur._conn = RunService.Heartbeat:Connect(function(dt)
                                        if not cur or not cur.spinF or not cur.spinF.Parent or not cur.spinF.Visible then
                                            if cur and cur._conn then cur._conn:Disconnect(); cur._conn = nil end
                                            return
                                        end
                                        ang = ang + (dt or 0.016) * 4.5
                                        local n = 0
                                        for _, k in ipairs(cur.spinF:GetChildren()) do
                                            if k:IsA('Frame') and k.Size and k.Size.X and k.Size.X.Offset and k.Size.X.Offset <= 4 then
                                                n = n + 1
                                                local a = ang + math.rad((n - 1) * 36)
                                                k.Position = UDim2.new(0.5, math.sin(a) * 8.5, 0.5, -math.cos(a) * 8.5)
                                            end
                                        end
                                    end)
                                end
                            elseif cur._conn then
                                cur._conn:Disconnect()
                                cur._conn = nil
                            end
                        end
                         
                         
                        local x = cur.actionL.Position.X.Offset
                        if shared.active and x <= 10 then
                            cur.actionL.Position = UDim2.new(0, 30, 0, 4)
                            cur.actionL.Size = UDim2.new(1, -36, 0, 14)
                        elseif not shared.active and x >= 20 then
                            cur.actionL.Position = UDim2.new(0, 4, 0, 4)
                            cur.actionL.Size = UDim2.new(1, -8, 0, 14)
                        end
                    end)
                end
            end)
        end
    end

     
     
     
