        local function rsPx(n) return math.floor(n * rsSF + 0.5) end
        local INIT_W, INIT_H = rsPx(mobile and 465 or 558), rsPx(mobile and 286 or 515)
        local MIN_W, MIN_H = rsPx(mobile and 330 or 420), rsPx(mobile and 180 or 360)
        local root = _new('Frame')
        root.Name = 'Main'
        root.Active = true
        root.Size = UDim2.fromOffset(INIT_W, INIT_H)
        root.AnchorPoint = Vector2.new(0.5, 0.5)
        root.Position = UDim2.fromScale(0.5, 0.42)

        -- apply now (deferred so tabs built later are covered) and keep covering
        -- everything created afterwards: dialogs, update-log rows, tab content
        task.defer(function() pcall(function() PongiUI:ApplyResponsiveScale(root) end) end)
        root.DescendantAdded:Connect(function(d)
            task.defer(function()
                if d and d.Parent then
                    rsApplyOne(d, PongiUI.TextScale or 1, PongiUI.SizeScale or 1)
                end
            end)
        end)
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam:GetPropertyChangedSignal('ViewportSize'):Connect(function()
                    -- resize/rotate (or a resolution change) re-derives the factors
                    local ntf, nsf = rsComputeFactors()
                    if math.abs(ntf - (PongiUI.TextScale or 1)) > 0.02
                        or math.abs(nsf - (PongiUI.SizeScale or 1)) > 0.02 then
                        PongiUI:SetResponsiveScale(ntf, nsf)
                    end
