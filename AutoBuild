    function PongiUI:CreateSpinner(size, color)
        local col = color or Color3.fromRGB(150, 100, 230)
        local spinner = _new('Frame')
        spinner.BackgroundTransparency = 1
        spinner.Size = UDim2.fromOffset(size or 24, size or 24)
        spinner.Visible = false
        local ring = _new('Frame')
        ring.Size = UDim2.new(1, 0, 1, 0)
        ring.BackgroundTransparency = 1
        ring.BorderSizePixel = 2.5
        ring.BorderColor3 = col
        _new('UICorner', ring).CornerRadius = UDim.new(1, 0)
        ring.Parent = spinner
        local SPIN_FADE = {0, 0.25, 0.5, 0.7, 0.8, 0.85, 0.85, 0.85, 0.85, 0.85}
         
         
         
         
        local dots = {}
        for i = 1, 10 do
            local seg = _new('Frame')
            seg.Size = UDim2.fromOffset(3, 3)
            seg.AnchorPoint = Vector2.new(0.5, 0.5)
            seg.BackgroundColor3 = col
            seg.BackgroundTransparency = SPIN_FADE[i]
            seg.BorderSizePixel = 0
            _new('UICorner', seg).CornerRadius = UDim.new(1, 0)
            seg.Parent = spinner
            dots[i] = seg
        end
        local ang = 0
        local spinning = false
        local conn = nil
        local function placeDots()
            for i = 1, 10 do
                local a = ang + math.rad((i - 1) * 36)
                dots[i].Position = UDim2.new(0.5, math.sin(a) * 8.5, 0.5, -math.cos(a) * 8.5)
            end
        end
        local function stopSpin()
            spinning = false
            if conn then conn:Disconnect(); conn = nil end
        end
        local function startSpin()
            if spinning then return end
            spinning = true
            conn = game:GetService('RunService').Heartbeat:Connect(function(dt)
                if not spinner or not spinner.Visible or not spinner.Parent then
                    stopSpin()
                    return
                end
                local old = setthreadidentity and getthreadidentity() or 8
                if setthreadidentity then setthreadidentity(8) end
                pcall(function()
                    ang = ang + (dt or 0.016) * 4.5   
                    placeDots()
                end)
                if setthreadidentity then setthreadidentity(old) end
            end)
        end
        local obj = {
            Frame = spinner,
            SetBusy = function(_, busy)
                spinner.Visible = busy
                if busy then
                    startSpin()
                else
                    stopSpin()
                end
            end,
        }
        PongiUI._spinners[#PongiUI._spinners + 1] = obj
        return obj
    end

