    local keyPicker = function(label, id, info)
         
         
         
         
        local function coerceKey(k)
            if typeof(k) == 'EnumItem' then return k end
            if type(k) == 'string' then
                local short = k:match('Enum%.KeyCode%.(.+)$') or k
                return Enum.KeyCode[short]
            end
            return nil
        end
        local picker = _new('TextButton')
        picker.Size = UDim2.fromOffset(110, 26)
        picker.Position = UDim2.new(1, -118, 0, 3)
        picker.BackgroundColor3 = theme.main2
        picker.BorderSizePixel = 0
        picker.TextTruncate = Enum.TextTruncate.AtEnd
        picker.Font = DEFAULT_FONT
        picker.TextSize = 12
        picker.TextColor3 = theme.font
        corner(picker, 6)
        stroke(picker, theme.outline, 1)
        picker.Parent = label._frame

        local listening = false
        local captured = coerceKey(info.Default) or Enum.KeyCode.RightControl
        picker.Text = '[' .. captured.Name .. ']'
        local self = setmetatable({
            _picker = picker,
            _key = captured,
            _frame = label._frame,
            DisplayValue = captured,
        }, KeyPickerMeta)
        function self:SetValue(v, noEvent)
            local k = coerceKey(v)
            if k then
                captured = k
                self._key = k
                picker.Text = '[' .. k.Name .. ']'
            end
            if not noEvent and info.Changed then
                info.Changed(k and k.Name or v, {})
            end
        end
        local function beginCapture()
            listening = true
            captureCount = captureCount + 1
            picker.Text = '...'
            tween(picker, { BackgroundColor3 = theme.accent }, 0.15)
        end
        local function endCapture()
            listening = false
            if captureCount > 0 then captureCount = captureCount - 1 end
            tween(picker, { BackgroundColor3 = theme.main2 }, 0.15)
        end
        picker.Activated:Connect(function()
            beginCapture()
        end)
        UserInputService.InputBegan:Connect(function(input)
            if not listening then return end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                captured = input.KeyCode
                self._key = input.KeyCode
                picker.Text = '[' .. input.KeyCode.Name .. ']'
                endCapture()
                if info.Changed then
                     
                     
                    info.Changed(input.KeyCode.Name, {})
                end
            end
        end)

        Options[id] = self
        return self
    end

